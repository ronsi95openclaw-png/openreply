# Local PC-only OpenReply setup. Copy this file to .env.local before starting.
# Never commit .env.local.

# Generated with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-64-hex-characters
WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-secret

# Local dashboard login. No Resend or SMTP account is needed.
LOCAL_ADMIN_EMAIL=your-email@example.com
LOCAL_ADMIN_PASSWORD=choose-a-long-unique-password

NEXTAUTH_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/openreply
REDIS_URL=redis://redis:6379
CRON_BASE_URL=http://dashboard:3000

# Leave these blank until the Meta/Instagram connection stage.
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_SECRET=
